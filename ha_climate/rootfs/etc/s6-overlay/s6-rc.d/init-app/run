#!/command/with-contenv bashio
# shellcheck shell=bash
# One-shot initialisation: secrets, log level, database migrations, default data, cache.
set -e

APP_DIR=/opt/ha-climate/app
LEVEL_FILE="${APP_DIR}/config/packages/prod/monolog_level.yaml"
CONTAINER_ENV=/run/s6/container_environment

mkdir -p /data

# --- Log level: the add-on option when running under the Supervisor, HA_CLIMATE_LOG_LEVEL otherwise -------------------
if [[ -f /data/options.json ]]; then
    log_level="$(bashio::config 'log_level')"
else
    log_level="${HA_CLIMATE_LOG_LEVEL:-info}"
fi
case "${log_level}" in
    trace | debug) monolog_level=debug ;;
    notice) monolog_level=notice ;;
    warning) monolog_level=warning ;;
    error) monolog_level=error ;;
    fatal) monolog_level=critical ;;
    *) monolog_level=info ;;
esac

# --- Secrets, generated once and persisted in /data ---------------------------------------------------------
random_hex() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

if [[ ! -s /data/app_secret ]]; then
    (umask 077 && random_hex > /data/app_secret)
fi
if [[ ! -s /data/engine.token ]]; then
    (umask 077 && random_hex > /data/engine.token)
fi
chmod 600 /data/app_secret /data/engine.token
chown -R app:app /data

# Make the secret visible to the other services (they start through with-contenv).
printf '%s' "$(cat /data/app_secret)" > "${CONTAINER_ENV}/APP_SECRET"

# --- Log level -> Monolog config; the compiled cache must be rebuilt when it changes -------------------------
new_level="$(printf 'monolog:\n    handlers:\n        main:\n            level: %s\n' "${monolog_level}")"
if [[ "$(cat "${LEVEL_FILE}")" != *"level: ${monolog_level}" ]]; then
    printf '# Generated by init-app from the log_level option.\n%s\n' "${new_level}" > "${LEVEL_FILE}"
    rm -rf "${APP_DIR}/var/cache/prod"
fi

# --- Database and cache (as the unprivileged user) ----------------------------------------------------------
bashio::log.info "Applying database migrations"
cd "${APP_DIR}"
/command/s6-setuidgid app php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
/command/s6-setuidgid app php bin/console app:seed-defaults --no-interaction
/command/s6-setuidgid app php bin/console cache:warmup --env=prod --no-debug
bashio::log.info "Initialisation done (log level: ${log_level})"
